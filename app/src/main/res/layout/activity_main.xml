<?xml version="1.0" encoding="utf-8"?>
<com.chitang.mitime.AtmosphereScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fitsSystemWindows="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/pageContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="790dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:paddingBottom="26dp">

        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:translationY="6dp">

                <TextView
                    android:id="@+id/appTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/homeSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/home_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/themeToggleButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/theme_switch_to_light"
                android:padding="13dp"
                android:scaleType="center"
                android:src="@drawable/ic_theme_sun" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/statusPanel"
            android:layout_width="match_parent"
            android:layout_height="316dp"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/statusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:text="@string/time_floating_window"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/timePillWrap"
                android:layout_width="match_parent"
                android:layout_height="116dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginStart="14dp"
                android:layout_marginTop="86dp"
                android:layout_marginEnd="14dp"
                android:baselineAligned="false"
                android:elevation="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="34dp"
                android:paddingEnd="28dp"
                android:rotation="-7">

                <ImageView
                    android:id="@+id/floatingIcon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@string/time_floating_window"
                    android:src="@drawable/ic_tile_on" />

                <TextView
                    android:id="@+id/timePreviewText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:fontFamily="sans"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="21:49:08"
                    android:textColor="@color/text_primary"
                    android:textSize="45sp" />
            </LinearLayout>

            <View
                android:id="@+id/connectorLine"
                android:layout_width="1dp"
                android:layout_height="52dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginStart="44dp"
                android:layout_marginBottom="84dp"
                android:rotation="-28" />

            <LinearLayout
                android:id="@+id/statusChip"
                android:layout_width="218dp"
                android:layout_height="70dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:baselineAligned="false"
                android:clickable="true"
                android:elevation="5dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:translationX="42dp">

                <ImageView
                    android:id="@+id/statusDot"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/time_floating_window"
                    android:src="@drawable/ic_switch_off" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/status_disabled"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/verifyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/toggle_hint_turn_on"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/permissionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:baselineAligned="false"
            android:elevation="5dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/readinessTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/readiness_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/statusIconWrap"
                    android:layout_width="34dp"
                    android:layout_height="34dp">

                    <ImageView
                        android:id="@+id/permissionDot"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/write_settings_permission"
                        android:src="@drawable/ic_permission_shield" />
                </FrameLayout>

                <TextView
                    android:id="@+id/permissionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/write_settings_permission"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/permissionButton"
                    android:layout_width="72dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/write_settings_open"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:id="@+id/readinessDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="44dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/tileIconWrap"
                    android:layout_width="34dp"
                    android:layout_height="34dp">

                    <ImageView
                        android:id="@+id/tileIcon"
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/quick_settings_tile"
                        android:src="@drawable/ic_tile_off" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tileTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/quick_settings_tile"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tileButton"
                    android:layout_width="72dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/quick_settings_tile_add"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:id="@+id/widgetManualHintDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="44dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/widgetManualHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="44dp"
                android:layout_marginEnd="4dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:text="@string/home_widget_manual_hint"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/footerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/app_footer_fallback"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</com.chitang.mitime.AtmosphereScrollView>
